# Environment Variables for Logistics App

# Backend API URL
# Development (local) - user-service runs on port 8081:
EXPO_PUBLIC_API_URL=http://localhost:8081

# Production:
# EXPO_PUBLIC_API_URL=https://api.yourbackend.com

# Google OAuth web client ID
# Create one at: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized JavaScript origins must include your app's origin (e.g. http://localhost:8081 and your prod domain)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
